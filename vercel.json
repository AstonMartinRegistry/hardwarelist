{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/submit.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/locallist", "destination": "/public/locallist.html" },
    { "source": "/hamsters", "destination": "/public/hamsters.html" },
    { "source": "/((?!api/).*)", "destination": "/public/$1" }
  ]
}
