NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# Optional (default: plmlist)
# SUPABASE_SETUPS_TABLE=plmlist

# Reddit ingest (built into /api/cron-ingest-reddit — no Cloudflare)
# Generate with: openssl rand -hex 32
CRON_SECRET=long-random-cron-secret

# Cerebras (classifier + later WhatsApp chat model)
CEREBRAS_API_KEY=csk-...
# CEREBRAS_CLASSIFY_MODEL=gpt-oss-120b
# CEREBRAS_CHAT_MODEL=zai-glm-4.7

# Optional overrides
# REDDIT_SUBREDDIT=LocalLLM
# INGEST_API_SECRET=same-as-cron-or-other
