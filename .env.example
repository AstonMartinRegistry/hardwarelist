NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# Optional (default: plmlist)
# SUPABASE_SETUPS_TABLE=plmlist

# Reddit ingest (built into /api/cron-ingest-reddit — no Cloudflare)
# Generate with: openssl rand -hex 32
CRON_SECRET=long-random-cron-secret

# Cerebras (classifier + WhatsApp chat model)
CEREBRAS_API_KEY=csk-...
# CEREBRAS_CLASSIFY_MODEL=gpt-oss-120b
# CEREBRAS_CHAT_MODEL=zai-glm-4.7

# WhatsApp Cloud API (Meta)
# Create an app at https://developers.facebook.com/ → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_TO_NUMBER=15551234567
# Same value you enter in Meta webhook "Verify token"
WHATSAPP_VERIFY_TOKEN=plmlist-verify-change-me
# App secret (for webhook signature checks)
WHATSAPP_APP_SECRET=...
# Optional: comma-separated E.164 digits allowed to chat (defaults to TO_NUMBER)
# WHATSAPP_ALLOWLIST=15551234567

# Optional overrides
# REDDIT_SUBREDDIT=LocalLLM
# INGEST_API_SECRET=same-as-cron-or-other
