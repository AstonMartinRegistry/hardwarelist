# Used locally with `python3 app.py` (Gmail SMTP)
SENDER_EMAIL=you@gmail.com
SENDER_PASSWORD=xxxx xxxx xxxx xxxx
RECEIVER_EMAIL=you@gmail.com

# Required on Vercel (Gmail SMTP crashes serverless → Cloudflare 502)
# https://resend.com — free tier is enough
RESEND_API_KEY=re_xxxxxxxxx
# Optional verified sender; defaults to onboarding@resend.dev for testing
# RESEND_FROM=PLM List <onboarding@resend.dev>
